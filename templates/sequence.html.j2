<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ html_metadata.get("title", tweaks.get("html", {}).get("title", plan_code ~ " " ~ plan.intake)) }}</title>
  <meta name="description" content="{{ html_metadata.get('subject', '') }}">
  <meta name="author" content="{{ html_metadata.get('author', '') }}">
  <meta name="generator" content="{{ html_metadata.get('creator', '') }}">
  <meta name="dcterms.title" content="{{ html_metadata.get('title', '') }}">
  <meta name="dcterms.subject" content="{{ html_metadata.get('subject', '') }}">
  <meta name="dcterms.creator" content="{{ html_metadata.get('author', '') }}">
  <meta name="dcterms.contributor" content="{{ html_metadata.get('creator', '') }}">
  {% include "sequence-style.html.j2" ignore missing %}
</head>
<body>
  <main>
    <section class="intro">
      <h1>{{ tweaks.get("html", {}).get("heading", plan_code ~ " Sequence") }}</h1>
      <div class="meta">
        {{ plan.intake }} | {{ rule.program_name }} | {{ rule.specialisation_names | join(", ") }}
      </div>
      {% if rule.validity_from or rule.validity_to %}
      <div class="meta">Rule validity: {{ rule.validity_from }} - {{ rule.validity_to }}</div>
      {% endif %}
      {% if top_disclaimer_html %}
      <div class="meta disclaimer">{{ top_disclaimer_html }}</div>
      {% endif %}
    </section>

    {% for year in years %}
    <details
      class="year calendar-family-{{ year.calendar_family|default('unknown') }} calendar-model-{{ year.calendar_model|default('unknown') }}"
      data-calendar-family="{{ year.calendar_family|default('unknown') }}"
      data-calendar-model="{{ year.calendar_model|default('unknown') }}"
      open
    >
      <summary>{{ year.enrol_year }} ({{ year.year }})</summary>
      <div class="periods">
        {% for period in year.periods %}
        {% set period_slug = period.period|lower|replace(' ', '-') %}
        <section class="period period-{{ period_slug }}">
          <h3 class="period-label period-{{ period_slug }}">{{ period.period }}</h3>
          <table>
            <tbody>
              {% for course in period.courses %}
              {% set course_link = course_link_for(course) %}
              <tr>
                <td class="code">
                  {% if course_link %}
                  <a class="course-link" href="{{ course_link | e }}">{{ course.code }}</a>
                  {% else %}
                  {{ course.code }}
                  {% endif %}
                </td>
                <td>
                  {% if course_link %}
                  <a class="course-link" href="{{ course_link | e }}">
                  {{ course.title }}
                  {% if course.uoc != 6 %}
                    <span class="uoc">({{ course.uoc }} UoC)</span>
                  {% endif %}
                  </a>
                  {% else %}
                  {{ course.title }}
                  {% if course.uoc != 6 %}
                    <span class="uoc">({{ course.uoc }} UoC)</span>
                  {% endif %}
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </section>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </main>
  <footer class="footer-block">
    {% if footer_lines_html %}
      <div class="footer-single">
        {% for line in footer_lines_html %}
          <div>{{ line }}</div>
        {% endfor %}
      </div>
    {% endif %}
  </footer>
</body>
</html>
