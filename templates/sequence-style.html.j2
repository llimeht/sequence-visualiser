<style>
  .intro-heading {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .intro-logo {
    height: 48px;
    width: auto;
    display: block;
    margin-right: 12px;
  }
  :root {
    --bg: #f3f6fb;
    --panel: #ffffff;
    --ink: #10233a;
    --accent: #0d5f8f;
    --line: #d4dfeb;
    --period-term-1: {{ css_variables.get("period-term-1", "#f2f2f2") }};
    --period-term-2: {{ css_variables.get("period-term-2", "#e8e8e8") }};
    --period-term-3: {{ css_variables.get("period-term-3", "#dedede") }};
    --period-semester-1: {{ css_variables.get("period-semester-1", "#ededed") }};
    --period-semester-2: {{ css_variables.get("period-semester-2", "#e2e2e2") }};
    --period-summer-term: {{ css_variables.get("period-summer-term", "#fff5d6") }};
    --period-winter-term: {{ css_variables.get("period-winter-term", "#dff1ff") }};
    --link-colour: {{ css_variables.get("link-colour", css_variables.get("link-color", "var(--accent)")) }};
    --link-underline: {{ css_variables.get("link-underline", "underline") }};
    --course-link-colour: {{ css_variables.get("course-link-colour", "currentColor") }};
    --course-link-underline: {{ css_variables.get("course-link-underline", "none") }};
  }
  body {
    margin: 0;
    background: linear-gradient(180deg, #edf2f8 0%, #f8fbff 100%);
    color: var(--ink);
    font-family: "Source Sans 3", "Segoe UI", sans-serif;
  }
  main {
    max-width: 1100px;
    margin: 24px auto 40px;
    padding: 0 16px;
  }
  .intro {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }
  h1 { margin: 0 0 8px; font-size: 1.35rem; }
  .meta { font-size: 0.95rem; color: #3a4f67; }
  details.year {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  details.year > summary {
    cursor: pointer;
    list-style: none;
    padding: 12px 14px;
    font-weight: 700;
    background: #eff6ff;
    border-bottom: 1px solid var(--line);
  }
  details.year > summary::-webkit-details-marker { display: none; }
  .periods { padding: 10px; display: grid; gap: 10px; }
  .period {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .period h3 {
    margin: 0;
    padding: 10px;
    font-size: 1rem;
    color: #0d3f66;
    background: #f4f9ff;
    border-bottom: 1px solid var(--line);
  }
  .calendar-model-trimesters-standard .period-label.period-term-1 { background: var(--period-term-1); }
  .calendar-model-trimesters-standard .period-label.period-term-2 { background: var(--period-term-2); }
  .calendar-model-trimesters-standard .period-label.period-term-3 { background: var(--period-term-3); }
  .calendar-model-trimesters-extended .period-label.period-summer-term { background: var(--period-summer-term); }
  .calendar-model-trimesters-extended .period-label.period-term-1 { background: var(--period-term-1); }
  .calendar-model-trimesters-extended .period-label.period-term-2 { background: var(--period-term-2); }
  .calendar-model-trimesters-extended .period-label.period-term-3 { background: var(--period-term-3); }
  .calendar-model-semesters-standard .period-label.period-semester-1 { background: var(--period-semester-1); }
  .calendar-model-semesters-standard .period-label.period-semester-2 { background: var(--period-semester-2); }
  .calendar-model-semesters-extended .period-label.period-summer-term { background: var(--period-summer-term); }
  .calendar-model-semesters-extended .period-label.period-semester-1 { background: var(--period-semester-1); }
  .calendar-model-semesters-extended .period-label.period-winter-term { background: var(--period-winter-term); }
  .calendar-model-semesters-extended .period-label.period-semester-2 { background: var(--period-semester-2); }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  td {
    border-top: 1px solid var(--line);
    padding: 8px 10px;
    vertical-align: top;
  }
  td.code {
    width: 175px;
    font-weight: 700;
    color: var(--accent);
    font-family: "JetBrains Mono", "Consolas", monospace;
  }
  .uoc { color: #355574; font-size: 0.9rem; }
  .course-link {
    color: var(--course-link-colour);
    text-decoration-line: var(--course-link-underline);
    text-underline-offset: 2px;
  }
  .course-link:hover {
    color: var(--course-link-colour);
  }
  @media (max-width: 760px) {
    td.code { width: 135px; }
    .period h3 { font-size: 0.95rem; }
  }
  .disclaimer {
    margin-top: 1em;
  }
  .disclaimer a,
  .footer-single a {
    color: var(--link-colour);
    text-decoration-line: var(--link-underline);
    text-underline-offset: 2px;
  }
  .disclaimer a:hover,
  .footer-single a:hover {
    color: var(--link-colour);
  }
  .footer-block {
    margin-top: 48px;
    padding: 18px 0 8px 0;
    border-top: 1px solid #d4dfeb;
    color: #3a4f67;
    font-size: 0.97rem;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .footer-single {
    margin-bottom: 0.7em;
  }
  .footer-single div {
    line-height: 1.5;
  }
  </style>
